<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t.title }}</title>
<style>
  :root {
    --bg: #f6f7f9; --card: #ffffff; --text: #1d2330; --muted: #5f6b7a; --border: #dfe3ea;
    --accent: #2457c5; --match: #1e7a46; --maybe: #9a6a00; --no: #a33a3a;
    --chip: #eef1f6;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12151b; --card: #1b2029; --text: #e6e9ef; --muted: #9aa5b4; --border: #2c3340;
      --accent: #7ea6ff; --match: #5fd08f; --maybe: #e6b94d; --no: #f08585; --chip: #252c38;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 980px; margin: 0 auto; padding: 24px 16px 48px; }
  header h1 { margin: 0 0 4px; font-size: 24px; }
  header p { margin: 0; color: var(--muted); font-size: 13px; }
  .bar { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 12px; align-items: center; }
  .tab { border: 1px solid var(--border); background: var(--card); color: var(--text);
         padding: 6px 12px; border-radius: 999px; cursor: pointer; font: inherit; }
  .tab[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .tab span { opacity: .75; margin-left: 4px; }
  input[type=search] { flex: 1 1 220px; min-width: 0; padding: 7px 12px; border-radius: 8px;
         border: 1px solid var(--border); background: var(--card); color: var(--text); font: inherit; }
  .hint { color: var(--muted); font-size: 13px; margin: 0 0 16px; }
  article { background: var(--card); border: 1px solid var(--border); border-radius: 10px;
            padding: 14px 16px; margin-bottom: 10px; display: grid;
            grid-template-columns: 64px 1fr; gap: 14px; }
  article[hidden] { display: none; }
  .score { text-align: center; font-weight: 700; font-size: 22px; line-height: 1.1; }
  .score small { display: block; font-size: 11px; font-weight: 500; color: var(--muted); }
  .match .score { color: var(--match); } .maybe .score { color: var(--maybe); }
  .no .score { color: var(--no); }
  h2 { margin: 0; font-size: 16px; }
  h2 a { color: var(--text); text-decoration: none; }
  h2 a:hover { color: var(--accent); text-decoration: underline; }
  .meta { color: var(--muted); font-size: 13px; margin: 2px 0 8px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 6px; }
  .chip { background: var(--chip); border-radius: 6px; padding: 1px 8px; font-size: 12px; }
  .chip.status { background: var(--accent); color: #fff; }
  ul { margin: 4px 0 0; padding-left: 18px; font-size: 13.5px; }
  .missing { color: var(--no); }
  .empty { color: var(--muted); text-align: center; padding: 32px 0; }
  @media (max-width: 520px) { article { grid-template-columns: 1fr; gap: 6px; }
                              .score { text-align: left; } }
</style>
</head>
<body>
<main>
  <header>
    <h1>{{ t.title }}</h1>
    <p>{{ t.generated }}: {{ generated }} · {{ total }} · min {{ min_score }}</p>
  </header>

  <div class="bar" role="toolbar">
    {% for key in ["match", "maybe", "tracked", "no", "all"] %}
    <button class="tab" data-tab="{{ key }}" aria-pressed="{{ 'true' if key == 'match' else 'false' }}">
      {{ t[key] }}<span>{{ counts[key] if key != "all" else total }}</span>
    </button>
    {% endfor %}
    <input type="search" id="q" placeholder="{{ t.search }}">
  </div>
  <p class="hint">{{ t.tracker_hint }}</p>

  <section id="list">
  {% for item in items %}
    {% set r = item.row %}
    <article class="{{ item.bucket }}" data-bucket="{{ item.bucket }}"
             data-tracked="{{ 1 if item.tracked else 0 }}"
             data-text="{{ (r.title ~ ' ' ~ r.company ~ ' ' ~ r.location) | lower }}">
      <div class="score">{{ r.final_score if r.final_score is not none else "–" }}
        <small>{{ t.score }}</small></div>
      <div>
        <h2><a href="{{ r.url }}" target="_blank" rel="noopener noreferrer">{{ r.title }}</a></h2>
        <div class="meta">
          {{ r.company or "?" }}{% if r.location %} · {{ r.location }}{% endif %}
          {% if r.workplace %} · {{ t.workplace.get(r.workplace, r.workplace) }}{% endif %}
          · {{ r.first_seen[:10] }}
          {% if r.seen_count > 1 %} · {{ t.seen.format(n=r.seen_count) }}{% endif %}
        </div>
        <div class="chips">
          {% if r.status != "new" %}<span class="chip status">{{ t.status.get(r.status, r.status) }}</span>{% endif %}
          {% if r.rule_score is not none %}<span class="chip">{{ t.rule }} {{ r.rule_score }}</span>{% endif %}
          {% if r.llm_score is not none %}<span class="chip">{{ t.llm }} {{ r.llm_score }}</span>{% endif %}
          {% for x in r.extra[:3] %}<span class="chip">{{ x }}</span>{% endfor %}
        </div>
        {% if r.llm_reasons or r.rule_reasons or r.llm_missing %}
        <ul>
          {% for reason in r.llm_reasons %}<li>{{ reason }}</li>{% endfor %}
          {% for reason in r.rule_reasons %}<li>{{ reason }}</li>{% endfor %}
          {% for m in r.llm_missing %}<li class="missing">{{ t.missing }}: {{ m }}</li>{% endfor %}
        </ul>
        {% endif %}
        {% if r.note %}<p class="meta">📝 {{ r.note }}</p>{% endif %}
      </div>
    </article>
  {% endfor %}
  </section>
  <p class="empty" id="empty" hidden>{{ t.empty }}</p>
</main>
<script>
  const tabs = document.querySelectorAll(".tab");
  const cards = document.querySelectorAll("article");
  const q = document.getElementById("q");
  let current = "match";
  function apply() {
    const needle = q.value.trim().toLocaleLowerCase();
    let shown = 0;
    cards.forEach(c => {
      const inTab = current === "all" || (current === "tracked" ? c.dataset.tracked === "1"
                                                                : c.dataset.bucket === current);
      const ok = inTab && (!needle || c.dataset.text.includes(needle));
      c.hidden = !ok; if (ok) shown++;
    });
    document.getElementById("empty").hidden = shown > 0;
  }
  tabs.forEach(b => b.addEventListener("click", () => {
    current = b.dataset.tab;
    tabs.forEach(x => x.setAttribute("aria-pressed", x === b ? "true" : "false"));
    apply();
  }));
  q.addEventListener("input", apply);
  apply();
</script>
</body>
</html>
